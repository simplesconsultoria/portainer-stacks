# Sample env values for `make validate` (`docker compose config`).
# Placeholder values only — never put real secrets here.

# Stack identity & placement
STACK_NAME=plone-demo
STACK_PREFIX=demo
STACK_ENV=staging
SITE_ID=Plone
STACK_FRONTEND_REPLICAS=1
STACK_FRONTEND_TYPE=app
STACK_BACKEND_REPLICAS=1
STACK_BACKEND_TYPE=app

# Images
IMAGE_FRONTEND=plone/plone-frontend
IMAGE_FRONTEND_TAG=latest
IMAGE_BACKEND=plone/plone-backend
IMAGE_BACKEND_TAG=latest

# Routing & TLS
DEPLOY_HOSTNAME=demo.example.com
CERTRESOLVER=le-cloudflare
FRONTEND_MIDDLEWARES=gzip
BASIC_AUTH_USER=CHANGE_ME
BASIC_AUTH_PASSWORD_HASH=CHANGE_ME
