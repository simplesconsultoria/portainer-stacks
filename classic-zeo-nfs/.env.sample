# Sample env values for `make validate` (`docker compose config`).
# Placeholder values only — never put real secrets here.

# Stack identity & placement
STACK_NAME=classic-zeo-nfs
STACK_PREFIX=classic-zeo
STACK_ENV=staging
SITE_ID=Plone
STACK_BACKEND_REPLICAS=1
STACK_BACKEND_TYPE=app
STACK_DB_TYPE=data

# Images (backend and db use the same legacy image)
IMAGE_BACKEND=plone/plone
IMAGE_BACKEND_TAG=3.3.6
IMAGE_DB=plone/plone
IMAGE_DB_TAG=3.3.6
BACKEND_ENTRYPOINT=/docker-entrypoint.sh
BACKEND_COMMAND=start

# ZEO
ZEO_PORT=8100
ZEO_STORAGE=1

# NFS storage (pre-created by cluster_playbook before deploy)
NFS_HOST=nfs.example.com
NFS_BASE_DIR=/srv/plone/classic-zeo-nfs

# Routing & TLS
DEPLOY_HOSTNAME=site.example.com
CERTRESOLVER=le-cloudflare
BACKEND_MIDDLEWARES=gzip

# Swarm config holding the backend env file
BACKEND_ENV_VERSION=v0

# Networking
NETWORK_MTU=1450
